# ==============================================================================
# Maritime Knowledge Graph & Operations Assistant Environment Configuration
# ==============================================================================

# LLM Providers (OpenRouter, Groq, Google Gemini)
# ------------------------------------------------------------------------------
# Primary recommended provider: OpenRouter (DeepSeek V4 Flash Vision / Qwen)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-vision-exp
OPENROUTER_PROVIDER_NAME=deepinfra/fp8
OPENROUTER_MAX_TOKENS=4096
SUMMARIZATION_TOKEN_TRIGGER=2048

# Alternative LLM Providers
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Neo4j Database Configuration
# ------------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=maritime-kg

# LangSmith / LangChain Tracing (Optional for observability)
# ------------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
LANGCHAIN_PROJECT=maritime
