# ==============================================================================
# Maritime Knowledge Graph & Operations Assistant Environment Configuration
# Copy to .env and fill in the values marked "your_...".
# ==============================================================================

# LLM: Azure AI (OpenAI-compatible endpoint)
# ------------------------------------------------------------------------------
LLM_PROVIDER=azure
AZURE_API_KEY=your_azure_api_key_here
# Endpoint of your Azure AI resource, ending in /openai/v1
AZURE_ENDPOINT=https://your-resource-name.services.ai.azure.com/openai/v1
# Name of the model deployment to call
AZURE_DEPLOYMENT_NAME=your_deployment_name_here
AZURE_MAX_TOKENS=8192
# Reasoning/preview models (names containing luna, o1, o3, reasoning, preview) reject temperature=0,
# so the app omits it for them automatically. To force a value, or to omit it for any model, uncomment:
# AZURE_TEMPERATURE=none
SUMMARIZATION_TOKEN_TRIGGER=2048

# Neo4j Database Configuration
# ------------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=maritime-kg

# Services
# ------------------------------------------------------------------------------
# Where the agent finds the MCP server (start.py sets this automatically)
MARITIME_MCP_SERVER_URL=http://localhost:8000/mcp
# Secret used to sign API login tokens (JWT). Change it for any shared deployment.
JWT_SECRET=change-me-before-sharing
# Optional bearer token if you protect the MCP server
# MCP_SERVER_TOKEN=

# LangSmith / LangChain Tracing (optional, off by default)
# ------------------------------------------------------------------------------
# When true, every run (prompts, tool calls and the data they return) is sent to your LangSmith project.
# Note: values in this file override variables set in the shell, so this is the switch that counts.
LANGCHAIN_TRACING_V2=false
# LANGSMITH_API_KEY=your_langsmith_api_key_here
# LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
# LANGCHAIN_PROJECT=maritime
